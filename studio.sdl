application {
    name "Themed SVG Studio"
    version "0.1.0"
    channel "development"
    protocolVersion 1
}

bridge {
    executable "themed-svg-stdio"
    transport "jsonl"
    timeoutMilliseconds 15000
}

editor {
    autosave false
    undoLimit 64
    previewMode "host"
}

updates {
    provider "manual"
    status "not-configured"
    releasesUrl "https://github.com/dev-centr/themed-svg-studio/releases"
}
